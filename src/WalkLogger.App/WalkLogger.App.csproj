<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>WalkLogger.App.Program</StartupObject>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WalkLogger.Windows.Tests" />
    <ProjectReference Include="..\WalkLogger.Application\WalkLogger.Application.csproj" />
    <ProjectReference Include="..\WalkLogger.Presentation\WalkLogger.Presentation.csproj" />
    <ProjectReference Include="..\WalkLogger.Infrastructure.Windows\WalkLogger.Infrastructure.Windows.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <Content Include="Map\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\**\*" Link="Samples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
