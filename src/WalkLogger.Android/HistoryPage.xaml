<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:WalkLogger.Mobile"
             xmlns:recording="clr-namespace:WalkLogger.Recording;assembly=WalkLogger.Recording"
             x:Class="WalkLogger.Mobile.HistoryPage" x:DataType="local:RecorderViewModel"
             Title="記録一覧" SafeAreaEdges="All">
  <Grid Padding="16" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="16">
    <Label Text="街歩きの記録" FontSize="22" FontAttributes="Bold"
           SemanticProperties.HeadingLevel="Level1" />
    <CollectionView Grid.Row="1" ItemsSource="{Binding History}" SelectionMode="Single"
                    SelectedItem="{Binding Selected, Mode=TwoWay}">
      <CollectionView.EmptyView>
        <VerticalStackLayout Padding="0,24" Spacing="12">
          <Label Text="最初の街歩きを記録しよう" FontAttributes="Bold" />
          <Label Text="「記録」で開始すると、GPSと写真をここに保存します。GPS未取得の記録は共有できません。" />
        </VerticalStackLayout>
      </CollectionView.EmptyView>
      <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="recording:RecordedWalk">
          <VerticalStackLayout Padding="8,16" Spacing="6">
            <Label Text="{Binding Title}" FontAttributes="Bold" />
            <Label Text="{Binding Details}" FontSize="14" />
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#D8E1E7, Dark=#34434D}" />
          </VerticalStackLayout>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
    <Label Grid.Row="2" Text="{Binding Message}" TextColor="{AppThemeBinding Light=#943C26, Dark=#FFB4A2}" />
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="8">
      <Button Text="写真入りZIPを共有" Command="{Binding ExportZipCommand}" />
      <Button Grid.Row="1" Text="GPXを共有" Command="{Binding ExportGpxCommand}"
              Style="{StaticResource SecondaryButton}" />
    </Grid>
    <Label Grid.Row="4" Text="WindowsではZIPを展開し、「フォルダー取込」でtrack.ndjsonを含むフォルダーを選びます。GPX単体には写真を含みません。" FontSize="14" />
  </Grid>
</ContentPage>
